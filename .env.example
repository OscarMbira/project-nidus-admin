# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ADMIN_KEY=your-service-role-key

# Optional — run SQL migrations locally (requires database password, not service role key)
# Supabase Dashboard → Project Settings → Database → Connection string → Session pooler (URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[YOUR-DB-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or:
# SUPABASE_DB_PASSWORD=your-database-password
#
# RPC-only scripts (e.g. admin:seed-id-generation-display-id-backfill) use the service role key above.
# Check connectivity: pnpm run admin:db-doctor

# Module Federation URLs — remotes serve built remoteEntry.js via vite preview
VITE_ADMIN_USERS_URL=http://127.0.0.1:5180/assets/remoteEntry.js
VITE_ADMIN_SUBSCRIPTIONS_URL=http://127.0.0.1:5181/assets/remoteEntry.js
VITE_ADMIN_SYSTEM_URL=http://127.0.0.1:5182/assets/remoteEntry.js
VITE_ADMIN_SUPPORT_URL=http://127.0.0.1:5183/assets/remoteEntry.js
VITE_ADMIN_ERRORS_URL=http://127.0.0.1:5184/assets/remoteEntry.js
VITE_ADMIN_MIRRORS_URL=http://127.0.0.1:5185/assets/remoteEntry.js
VITE_ADMIN_PLATFORM_URL=http://127.0.0.1:5186/assets/remoteEntry.js
VITE_ADMIN_SIMULATOR_URL=http://127.0.0.1:5187/assets/remoteEntry.js
VITE_ADMIN_SECURITY_URL=http://127.0.0.1:5188/assets/remoteEntry.js
VITE_ADMIN_CONTENT_URL=http://127.0.0.1:5189/assets/remoteEntry.js
VITE_ADMIN_FEEDBACK_URL=http://127.0.0.1:5190/assets/remoteEntry.js
VITE_ADMIN_AUDIT_URL=http://127.0.0.1:5191/assets/remoteEntry.js
VITE_ADMIN_ADMIN_MGMT_URL=http://127.0.0.1:5192/assets/remoteEntry.js

# Target apps opened by user impersonation (Platform / Simulator user-facing apps)
VITE_PLATFORM_APP_URL=http://localhost:5173
VITE_SIMULATOR_APP_URL=http://localhost:5174
